{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/laravel-webhooks",
    "description": "Attribute-driven outgoing webhooks for Laravel: discover webhook events, manage subscriptions, deliver signed payloads.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "webhooks"
    ],
    "support": {
        "issues": "https://github.com/bambamboole/laravel-webhooks/issues",
        "source": "https://github.com/bambamboole/laravel-webhooks"
    },
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.16 || ^2.0",
        "spatie/laravel-webhook-server": "^3.10"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.16",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelWebhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\LaravelWebhooks\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "stan": "phpstan analyse",
        "check": [
            "pint --test",
            "phpstan analyse",
            "rector --dry-run",
            "@test"
        ],
        "lint": "pint --format agent",
        "refactor": "rector",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "fix": [
            "@refactor",
            "@lint"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@hooks:install",
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@hooks:install",
            "@boost:refresh"
        ],
        "hooks:install": "git config core.hooksPath .githooks 2>/dev/null || true",
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || { [ -f package.json ] && [ ! -d node_modules ]; } || vendor/bin/testbench boost:update --no-interaction || true",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php artisan serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelWebhooks\\WebhooksServiceProvider"
            ]
        },
        "extended-testbench": {
            "check-ignore": [
                "tests/Unit",
                "phpunit.xml.dist"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
